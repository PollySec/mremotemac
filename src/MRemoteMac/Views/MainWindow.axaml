<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:MRemoteMac.Converters"
        xmlns:c="using:MRemoteMac.Controls"
        xmlns:vm="using:MRemoteMac.ViewModels"
        xmlns:m="using:MRemoteMac.Models"
        xmlns:svc="using:MRemoteMac.Services"
        x:Class="MRemoteMac.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1180" Height="720" MinWidth="640" MinHeight="420">
    <Window.Resources>
        <conv:NodeIconConverter x:Key="NodeIcon" />
        <conv:GreaterThanZeroConverter x:Key="GtZero" />
        <conv:MessageClassBrushConverter x:Key="MessageBrush" />
    </Window.Resources>

    <DockPanel>
        <!-- ===== menu ===== -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="_File">
                <MenuItem Header="New Connection Database…" Click="OnNewFile">
                    <MenuItem.Icon><c:Icon Glyph="file-plus" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Connection Database or File…" Click="OnOpenFile" HotKey="Cmd+O" InputGesture="Cmd+O">
                    <MenuItem.Icon><c:Icon Glyph="folder-open" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Connections" Click="OnSaveFile" HotKey="Cmd+S" InputGesture="Cmd+S">
                    <MenuItem.Icon><c:Icon Glyph="save" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="History…" Click="OnHistory" HotKey="Cmd+Shift+H" InputGesture="Cmd+Shift+H">
                    <MenuItem.Icon><c:Icon Glyph="archive" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Import mRemoteNG File…" Click="OnImportFile">
                    <MenuItem.Icon><c:Icon Glyph="download" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export to mRemoteNG File…" Click="OnExportFile" HotKey="Cmd+Shift+S" InputGesture="Cmd+Shift+S">
                    <MenuItem.Icon><c:Icon Glyph="upload" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Set Master Password…" Click="OnSetMasterPassword">
                    <MenuItem.Icon><c:Icon Glyph="key-round" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Options…" Click="OnOptions" InputGesture="Cmd+OemComma">
                    <MenuItem.Icon><c:Icon Glyph="settings" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Quit mRemoteMac" Click="OnExit" InputGesture="Cmd+Q">
                    <MenuItem.Icon><c:Icon Glyph="log-out" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Sessions">
                <MenuItem Header="Next Session" Click="OnNextSession" HotKey="Cmd+Right" InputGesture="Cmd+Right" />
                <MenuItem Header="Previous Session" Click="OnPreviousSession" HotKey="Cmd+Left" InputGesture="Cmd+Left" />
                <Separator />
                <MenuItem Header="Reconnect" Click="OnTabReconnect">
                    <MenuItem.Icon><c:Icon Glyph="refresh-cw" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Disconnect" Click="OnTabDisconnect" HotKey="Cmd+W" InputGesture="Cmd+W">
                    <MenuItem.Icon><c:Icon Glyph="circle-stop" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Disconnect All" Click="OnDisconnectAll" />
                <Separator />
                <MenuItem Header="Send Special Keys">
                    <MenuItem.Icon><c:Icon Glyph="keyboard" /></MenuItem.Icon>
                    <MenuItem Header="Ctrl+Alt+Del" Click="OnSendCtrlAltDel" />
                    <MenuItem Header="Ctrl+Esc" Click="OnSendCtrlEsc" />
                    <MenuItem Header="Windows key" Click="OnSendWin" />
                    <MenuItem Header="Alt+Tab" Click="OnSendAltTab" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuViewNotifications" Header="Notifications" Click="OnToggleNotifications" ToggleType="CheckBox" />
                <MenuItem x:Name="MenuViewQuickConnect" Header="Quick Connect Toolbar" Click="OnToggleQuickConnect" ToggleType="CheckBox" />
                <Separator />
                <MenuItem Header="Reconnect All Sessions" Click="OnReconnectAll">
                    <MenuItem.Icon><c:Icon Glyph="refresh-cw" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reset Layout" Click="OnResetLayout">
                    <MenuItem.Icon><c:Icon Glyph="layout-grid" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Fullscreen" Click="OnToggleFullscreen" HotKey="F11" InputGesture="F11">
                    <MenuItem.Icon><c:Icon Glyph="maximize" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Copy Hostname" Click="OnCopyHostname">
                    <MenuItem.Icon><c:Icon Glyph="copy" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Connection File in Finder" Click="OnOpenFileFolder">
                    <MenuItem.Icon><c:Icon Glyph="folder" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard Shortcuts" Click="OnShortcuts" HotKey="F1" InputGesture="F1">
                    <MenuItem.Icon><c:Icon Glyph="keyboard" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="User Guide" Click="OnHelp">
                    <MenuItem.Icon><c:Icon Glyph="book-open" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="mRemoteMac on GitHub" Click="OnWebsite">
                    <MenuItem.Icon><c:Icon Glyph="external-link" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Report an Issue…" Click="OnReportIssue">
                    <MenuItem.Icon><c:Icon Glyph="bug" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Log Folder" Click="OnOpenLogFolder" />
                <Separator />
                <MenuItem Header="About mRemoteMac" Click="OnAbout">
                    <MenuItem.Icon><c:Icon Glyph="info" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ===== quick connect toolbar ===== -->
        <Border DockPanel.Dock="Top" x:Name="QuickConnectBar" Height="36" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Background="{DynamicResource SurfaceWindowBrush}">
            <StackPanel Orientation="Horizontal" Margin="10,0" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Quick connect" Classes="secondary" VerticalAlignment="Center" Margin="0,0,2,0" />
                <AutoCompleteBox x:Name="QuickConnectBox" Classes="quick" Width="260" Height="24" MinHeight="24" FontSize="12" Padding="0" VerticalAlignment="Center" Watermark="[user@]host[:port]" KeyDown="OnQuickConnectKeyDown" FilterMode="Contains" />
                <Button Classes="tool wide" x:Name="QuickConnectButton" ToolTip.Tip="Connect using RDP (⏎)" Click="OnQuickConnect">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:Icon Glyph="play" Classes="accent" Size="14" />
                        <TextBlock Text="RDP" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" x:Name="ConnectionsMenuButton" ToolTip.Tip="Open a connection from the tree" Click="OnConnectionsMenu">
                    <c:Icon Glyph="list-tree" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== dock area ===== -->
        <Grid x:Name="MainGrid" ColumnDefinitions="300,6,*" Background="{DynamicResource SurfaceWindowBrush}">
            <Grid x:Name="LeftGrid" Grid.Column="0" RowDefinitions="*,6,280" Margin="8,4,0,8">

                <!-- Connections panel -->
                <DockPanel Grid.Row="0">
                    <Border Classes="panelTitle" DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock Text="CONNECTIONS" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Classes="tool" x:Name="NewConnectionButton" ToolTip.Tip="New connection" Click="OnNewConnection"><c:Icon Glyph="square-plus" /></Button>
                                <Button Classes="tool" x:Name="NewFolderButton" ToolTip.Tip="New folder" Click="OnNewFolder"><c:Icon Glyph="folder-plus" /></Button>
                                <Border Classes="divider" />
                                <Button Classes="tool" x:Name="ExpandAllButton" ToolTip.Tip="Expand all folders" Click="OnExpandAll"><c:Icon Glyph="chevrons-up-down" /></Button>
                                <Button Classes="tool" x:Name="CollapseAllButton" ToolTip.Tip="Collapse all folders" Click="OnCollapseAll"><c:Icon Glyph="chevrons-down-up" /></Button>
                                <Button Classes="tool" x:Name="SortButton" ToolTip.Tip="Sort A–Z" Click="OnSortToggle"><c:Icon x:Name="SortIcon" Glyph="arrow-down-a-z" /></Button>
                                <Border Classes="divider" />
                                <Button Classes="tool" x:Name="FavoritesButton" ToolTip.Tip="Favourites" Click="OnFavorites"><c:Icon Glyph="star" /></Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="panelBody">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Height="30" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Background="{DynamicResource SurfaceContentBrush}">
                                <DockPanel>
                                    <c:Icon DockPanel.Dock="Left" Glyph="search" Size="14" Margin="10,0,6,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SearchBox" Classes="grid" Watermark="Search connections" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="0" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                                </DockPanel>
                            </Border>
                            <TreeView x:Name="Tree" Focusable="True" ItemsSource="{Binding TreeRoots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                      DoubleTapped="OnTreeDoubleTapped" KeyDown="OnTreeKeyDown">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem" x:DataType="m:ConnectionInfo">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                    <Style Selector="StackPanel.unsupported c|Icon, StackPanel.unsupported TextBlock">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="m:ConnectionInfo">
                                        <StackPanel Orientation="Horizontal" Height="22" Background="Transparent" Spacing="7"
                                                    Classes.unsupported="{Binding !IsSupported}" ToolTip.Tip="{Binding UnsupportedHint}">
                                            <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                <c:Icon Glyph="{Binding ., Converter={StaticResource NodeIcon}}" Size="16" />
                                                <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                         Fill="{DynamicResource StatusSuccessBrush}" Stroke="{DynamicResource SurfaceContentBrush}" StrokeThickness="1.5"
                                                         IsVisible="{Binding OpenConnections, Converter={StaticResource GtZero}}" />
                                            </Panel>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ContextMenu>
                                    <ContextMenu x:Name="TreeMenu" Opening="OnTreeMenuOpening">
                                        <MenuItem x:Name="MiConnect" Header="Connect" Click="OnConnect" InputGesture="Cmd+Shift+C">
                                            <MenuItem.Icon><c:Icon Glyph="play" Classes="accent" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiConnectOptions" Header="Connect with Options">
                                            <MenuItem Header="Connect to console session" Click="OnConnectConsole" />
                                            <MenuItem Header="Connect in fullscreen" Click="OnConnectFullscreen" />
                                            <MenuItem Header="Connect without credentials" Click="OnConnectNoCredentials" />
                                            <MenuItem Header="Connect in view-only mode" Click="OnConnectViewOnly" />
                                        </MenuItem>
                                        <MenuItem x:Name="MiDisconnect" Header="Disconnect" Click="OnDisconnectNode">
                                            <MenuItem.Icon><c:Icon Glyph="circle-stop" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="MiDuplicate" Header="Duplicate" Click="OnDuplicate" InputGesture="Cmd+D">
                                            <MenuItem.Icon><c:Icon Glyph="copy" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiRename" Header="Rename…" Click="OnRename" InputGesture="F2">
                                            <MenuItem.Icon><c:Icon Glyph="pencil" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiDelete" Header="Delete" Click="OnDelete" InputGesture="Delete">
                                            <MenuItem.Icon><c:Icon Glyph="trash" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="MiCopyHostname" Header="Copy Hostname" Click="OnCopyHostname" />
                                        <MenuItem x:Name="MiInheritance" Header="Inheritance">
                                            <MenuItem.Icon><c:Icon Glyph="git-fork" /></MenuItem.Icon>
                                            <MenuItem Header="Apply inheritance to children" Click="OnApplyInheritanceToChildren" />
                                            <MenuItem Header="Apply default inheritance" Click="OnApplyDefaultInheritance" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Import mRemoteNG File…" Click="OnImportFile">
                                            <MenuItem.Icon><c:Icon Glyph="download" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Export to mRemoteNG File…" Click="OnExportFile">
                                            <MenuItem.Icon><c:Icon Glyph="upload" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="New Connection" Click="OnNewConnection">
                                            <MenuItem.Icon><c:Icon Glyph="square-plus" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Folder" Click="OnNewFolder">
                                            <MenuItem.Icon><c:Icon Glyph="folder-plus" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Sort">
                                            <MenuItem Header="Ascending (A–Z)" Click="OnSortAsc" />
                                            <MenuItem Header="Descending (Z–A)" Click="OnSortDesc" />
                                        </MenuItem>
                                        <MenuItem x:Name="MiMoveUp" Header="Move Up" Click="OnMoveUp" InputGesture="Cmd+Up" />
                                        <MenuItem x:Name="MiMoveDown" Header="Move Down" Click="OnMoveDown" InputGesture="Cmd+Down" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="6" Background="Transparent" ResizeDirection="Rows" />

                <!-- Config panel -->
                <DockPanel Grid.Row="2">
                    <Border Classes="panelTitle" DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock Text="CONFIG" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton Classes="tool" x:Name="PropertiesButton" IsChecked="True" ToolTip.Tip="Properties" Click="OnShowProperties"><c:Icon Glyph="sliders-horizontal" /></ToggleButton>
                                <ToggleButton Classes="tool" x:Name="InheritanceButton" ToolTip.Tip="Inheritance" Click="OnShowInheritance"><c:Icon Glyph="git-fork" /></ToggleButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Classes="panelBody">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="30" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Background="{DynamicResource SurfaceContentBrush}">
                                <StackPanel Orientation="Horizontal" Margin="10,0" Spacing="7">
                                    <c:Icon x:Name="ConfigIcon" Glyph="monitor" Size="15" Classes="accent" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConfigTitle" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <c:PropertyGrid x:Name="ConfigGrid" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

            <Grid Grid.Column="2" x:Name="RightGrid" RowDefinitions="*,Auto" Margin="2,4,8,8">
                <!-- Sessions -->
                <Border Grid.Row="0" Classes="panelBody">
                    <Panel>
                        <TabControl x:Name="Tabs" Classes="documents" SelectionChanged="OnTabSelectionChanged" />
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <c:Icon Glyph="monitor-dot" Size="40" HorizontalAlignment="Center" Foreground="{DynamicResource BorderStrongBrush}" StrokeThickness="1.4" />
                            <TextBlock Text="No open sessions" Classes="secondary" HorizontalAlignment="Center" FontSize="14" />
                            <TextBlock Text="Double-click a connection, press ⏎ in the tree, or use Quick connect." Classes="caption" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </Border>

                <!-- Notifications (collapsible, like mRemoteNG's auto-hide panel) -->
                <DockPanel Grid.Row="1" x:Name="NotificationsPanel" Margin="0,6,0,0">
                    <Border Classes="panelTitle" DockPanel.Dock="Top" PointerPressed="OnToggleNotifications" Cursor="Hand">
                        <DockPanel>
                            <c:Icon DockPanel.Dock="Left" Glyph="bell" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <c:Icon DockPanel.Dock="Right" x:Name="NotificationsChevron" Glyph="chevron-down" Size="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="NotificationsTitle" Text="NOTIFICATIONS" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="NotificationsBody" Classes="panelBody" Height="150" IsVisible="False">
                        <ListBox x:Name="MessagesList" Classes="messages" ItemsSource="{Binding Notifications.Messages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:NotificationMessage">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Glyph="{Binding IconName}" Foreground="{Binding Class, Converter={StaticResource MessageBrush}}" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TimeText}" Classes="caption" VerticalAlignment="Center" Width="56" />
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="OnCopyMessage" />
                                    <MenuItem Header="Delete" Click="OnDeleteMessage" />
                                    <MenuItem Header="Clear All" Click="OnClearMessages" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
